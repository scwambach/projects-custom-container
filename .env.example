# Your Vikunja instance. If the connector runs on the same Docker host you can use the
# internal address instead, e.g. http://vikunja:3456
VIKUNJA_URL=https://projects.wambach-house.com

# Vikunja -> Settings -> API Tokens. Give it access to: projects, tasks, labels,
# task comments, task assignees, users (read). Set an expiry you're comfortable with.
VIKUNJA_TOKEN=

# The secret part of the connector URL. Generate with: openssl rand -hex 32
MCP_SECRET=

# Only needed if you use the bundled cloudflared service (docker compose --profile tunnel up -d)
CLOUDFLARE_TUNNEL_TOKEN=
